# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="ORBI"
RUNPOD_MODEL=kimi-k2.6
# public: pre-deployed Kimi model. No Pod or endpoint creation required.
RUNPOD_API_MODE=public
RUNPOD_API_KEY=your-runpod-api-key
# No RUNPOD_ENDPOINT_ID is needed for the public model API.
